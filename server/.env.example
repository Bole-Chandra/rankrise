PORT=5000
NODE_ENV=development

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get this from: https://cloud.mongodb.com → Your Cluster → Connect → Drivers
# Steps:
#   1. Go to https://cloud.mongodb.com
#   2. Click your cluster → "Connect" → "Drivers" → select Node.js
#   3. Copy the connection string
#   4. Replace <password> with your actual DB user password
#   5. Replace "myFirstDatabase" with "rankrise"
#
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rankrise?retryWrites=true&w=majority&appName=rankrise

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Required in production — the server refuses to start without a 32+ char value.
JWT_SECRET=your_jwt_secret_here_at_least_32_chars

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Local development frontend URL. In production, use your real domain(s),
# comma-separated if you serve both the apex and www:
# CLIENT_URL=https://rankrise.in,https://www.rankrise.in
CLIENT_URL=http://localhost:5173

# ─── Email (Nodemailer/SMTP) ──────────────────────────────────────────────────
# Used to send a notification email for every Admission and Contact/Enquiry
# form submission.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ RECOMMENDED: Brevo (free HTTP API — avoids SMTP port blocking entirely) │
# └─────────────────────────────────────────────────────────────────────────┘
# Many hosts (including Hostinger shared plans) block or throttle outbound
# SMTP to external providers like Gmail — this is a common, hard-to-diagnose
# reason emails silently never arrive. Brevo sends over HTTPS instead, so it
# isn't affected. Free tier: 300 emails/day, no credit card required.
#   1. Sign up at https://www.brevo.com
#   2. Settings → SMTP & API → API Keys → Generate a new key
#   3. Set the two values below — that's it, no SMTP settings needed.
BREVO_API_KEY=
EMAIL_FROM=info@rankrise.in
EMAIL_TO=info@rankrise.in

# ┌─────────────────────────────────────────────────────────────────────────┐
# │ ALTERNATIVE: SMTP (used automatically if BREVO_API_KEY is left blank)   │
# └─────────────────────────────────────────────────────────────────────────┘
# Hostinger email:
#   EMAIL_HOST=smtp.hostinger.com
#   EMAIL_PORT=465
#   EMAIL_SECURE=true
#   EMAIL_USER=info@rankrise.in
#   EMAIL_PASS=<your mailbox password>
#
# Gmail (needs an App Password, not your normal password —
# https://support.google.com/accounts/answer/185833 — and 2-Step
# Verification must be enabled on the account first):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=465
#   EMAIL_SECURE=true
#   EMAIL_USER=you@gmail.com
#   EMAIL_PASS=<16-char app password>
#
# If nothing is configured, form submissions still save fine — only the
# notification email is skipped (this is logged clearly on the server).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=rankriseinstitute@gmail.com
EMAIL_PASS=<16-char gmail app password>
EMAIL_TO=rankriseinstitute@gmail.com

# Run `npm run test:email` any time to test whichever method is active and
# get a clear pass/fail result with the specific reason for any failure.

# ─── Google Sign-In (Student/Teacher login & signup) ─────────────────────────
# Needed for the "Sign in with Google" button on the student/teacher login
# and signup pages. Get this from:
#   1. https://console.cloud.google.com → create/select a project
#   2. APIs & Services → Credentials → Create Credentials → OAuth Client ID
#   3. Application type: Web application
#   4. Authorized JavaScript origins: add your site's URL (e.g.
#      https://rankrise.in and http://localhost:5173 for local dev)
#   5. Copy the "Client ID" (ends in .apps.googleusercontent.com)
# This SAME value also needs to go in client/.env as VITE_GOOGLE_CLIENT_ID —
# see client/.env.example.
# Leaving this blank simply disables the "Sign in with Google" button.
GOOGLE_CLIENT_ID=
