# Only needed if the frontend and backend are deployed on DIFFERENT
# domains/subdomains on Hostinger (e.g. frontend on rankrise.in as a static
# site, backend on api.rankrise.in as a Node.js app).
#
# If you deploy them together (server/app.js serves client/dist directly),
# leave this unset entirely — the app will use same-origin relative /api
# calls automatically.
#
# VITE_API_URL=https://api.rankrise.in

# ─── Analytics & Ads (optional) ──────────────────────────────────────────────
# See src/config/tracking.js for full instructions on where to get each value.
# Leaving any of these blank simply disables that specific tag.
VITE_GA_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_LABEL_LEAD=
VITE_GOOGLE_ADS_LABEL_ADMISSION=
VITE_GOOGLE_ADS_LABEL_CALL=
VITE_GOOGLE_ADS_LABEL_WHATSAPP=
VITE_GOOGLE_ADS_LABEL_BROCHURE=

# ─── Google Tag Manager (optional) ────────────────────────────────────────────
# Container ID from tagmanager.google.com (looks like "GTM-XXXXXXX"). Blank =
# no GTM script loads at all. Don't also configure GA4/Ads tags inside GTM's
# own UI if you fill this in — this site already fires them directly above.
VITE_GTM_ID=

# ─── Search engine verification (optional) ───────────────────────────────────
# Google Search Console: Settings → Ownership verification → HTML tag method
#   → paste just the "content" value (not the whole meta tag)
# Bing Webmaster Tools: Settings → same idea
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# ─── Google Sign-In (Student/Teacher login & signup) ─────────────────────────
# Same Client ID as GOOGLE_CLIENT_ID in server/.env — see src/config/auth.js
# for full setup instructions. Blank = the "Sign in with Google" button
# just doesn't render.
VITE_GOOGLE_CLIENT_ID=
