{
  "name": "rankrise-educational-platform",
  "version": "1.0.0",
  "description": "Rankrise Educational Platform - Full Stack Application",
  "private": true,
  "scripts": {
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && cd client && npm install",
    "build": "cd client && npm install --no-audit --no-fund && npm run build",
    "start": "node server/server.js",
    "seed": "cd server && npm run seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.3"
  }
}
